HOST=127.0.0.1
PORT=8080

# alphavantage | finage | yfinance | eodhd | massive | fmp
MARKETDATA_PROVIDER=alphaVantage
MARKETDATA_AV_BASE=https://www.alphavantage.co
MARKETDATA_AV_KEY=
MARKETDATA_FINAGE_BASE=https://api.finage.co.uk
MARKETDATA_FINAGE_KEY=

# yfinance does not require an API key.
MARKETDATA_EODHD_BASE=https://eodhd.com/api
MARKETDATA_EODHD_KEY=
MARKETDATA_MASSIVE_BASE=https://api.massive.com
MARKETDATA_MASSIVE_KEY=
MARKETDATA_FMP_BASE=https://financialmodelingprep.com/stable
MARKETDATA_FMP_KEY=

# Increase this interval to fit your provider's request allowance.
MARKETDATA_POLL_SECONDS=3

CACHE_TTL_SECONDS=600
CACHE_MAX_SIZE=500
MODEL_RETRAIN_ENABLED=true
MODEL_RETRAIN_SYMBOLS=AAPL,MSFT,NVDA,SPY

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.2
